---
/** La landing completa (página `inicio`): lee bloques y colecciones de la fuente de contenido. */
import Base from '../layouts/Base.astro';
import DatosEvento from '../components/DatosEvento.astro';
import Portada from '../components/secciones/Portada.astro';
import Experiencias from '../components/secciones/Experiencias.astro';
import Vivir from '../components/secciones/Vivir.astro';
import Dia from '../components/secciones/Dia.astro';
import Noche from '../components/secciones/Noche.astro';
import Atracciones from '../components/secciones/Atracciones.astro';
import Concursos from '../components/secciones/Concursos.astro';
import Entradas from '../components/secciones/Entradas.astro';
import Stands from '../components/secciones/Stands.astro';
import Sponsors from '../components/secciones/Sponsors.astro';
import Galeria from '../components/secciones/Galeria.astro';
import Participar from '../components/secciones/Participar.astro';
import Ubicacion from '../components/secciones/Ubicacion.astro';
import Preguntas from '../components/secciones/Preguntas.astro';
import Final from '../components/secciones/Final.astro';
import { cargarBloques, coleccion } from '../lib/content';
import { dolares } from '../lib/formato';

const url = Astro.url;
const [b, localidades, pilares, cifras, destacados, programa, artistas, atracciones, concursos, pasos, paquetesStand, razones, paquetesSponsor, patrocinables, marcas, fotos, preguntas] =
  await Promise.all([
    cargarBloques(url),
    coleccion('localidades', url),
    coleccion('pilares', url),
    coleccion('cifras', url),
    coleccion('destacados', url),
    coleccion('programaDia', url),
    coleccion('artistas', url),
    coleccion('atracciones', url),
    coleccion('concursos', url),
    coleccion('pasos', url),
    coleccion('paquetesStand', url),
    coleccion('razonesSponsor', url),
    coleccion('paquetesSponsor', url),
    coleccion('experienciasPatrocinables', url),
    coleccion('marcasAliadas', url),
    coleccion('fotosGaleria', url),
    coleccion('preguntas', url),
  ]);
const masBarata = localidades.length ? Math.min(...localidades.map((l) => l.precio)) : null;
---

<Base
  b={b}
  titulo={b.t('inicio.seo.titulo')}
  descripcion={b.t('inicio.seo.descripcion')}
  compartirTitulo={b.t('inicio.seo.compartirTitulo')}
  compartirDescripcion={b.t('inicio.seo.compartirDescripcion')}
>
  <DatosEvento slot="head" b={b} localidades={localidades} />
  <Portada b={b} desde={masBarata === null ? null : dolares(masBarata)} />
  <Experiencias b={b} />
  <Vivir b={b} pilares={pilares} cifras={cifras} />
  <Dia b={b} destacados={destacados.filter((d) => d.experiencia === 'dia')} programa={programa} />
  <Noche b={b} destacados={destacados.filter((d) => d.experiencia === 'noche')} artistas={artistas} />
  <Atracciones b={b} atracciones={atracciones} />
  <Concursos b={b} concursos={concursos} pasos={pasos.filter((p) => p.grupo === 'concurso')} hayBases={!!b.rico('bases.contenido.texto')} />
  <Entradas b={b} localidades={localidades} />
  <Stands b={b} paquetes={paquetesStand} pasos={pasos.filter((p) => p.grupo === 'stand')} />
  <Sponsors b={b} razones={razones} paquetes={paquetesSponsor} patrocinables={patrocinables} marcas={marcas} />
  <Galeria b={b} fotos={fotos} />
  <Participar b={b} hayPrivacidad={!!b.rico('privacidad.contenido.texto')} />
  <Ubicacion b={b} />
  <Preguntas b={b} preguntas={preguntas} />
  <Final b={b} />
</Base>
