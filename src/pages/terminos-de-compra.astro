---
/** Página legal `compra` (Términos de compra). Mientras su texto esté vacío o pendiente, no existe (404). */
import Base from '../layouts/Base.astro';
import PaginaLegal from '../components/PaginaLegal.astro';
import { cargarBloques } from '../lib/content';

const b = await cargarBloques(Astro.url);
const html = b.rico('compra.contenido.texto');
if (!html) return Astro.rewrite('/404');
---

<Base b={b} titulo={b.t('compra.seo.titulo')} descripcion={b.t('compra.seo.descripcion')}>
  <PaginaLegal titulo={b.t('compra.contenido.titulo')} html={html} />
</Base>
