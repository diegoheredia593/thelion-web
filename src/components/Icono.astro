---

<svg
  class={clase}
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={etiqueta ? undefined : 'true'}
  role={etiqueta ? 'img' : undefined}
  aria-label={etiqueta}
  set:html={svg}
/>
