---
/** Cuerpo de una página legal: título y texto enriquecido. */
interface Props {
  titulo: string | null;
  html: string;
}
const { titulo, html } = Astro.props;
---

<article class="seccion legal">
  <div class="contenedor">
    <h1 class="h2">{titulo}</h1>
    <div class="texto" set:html={html} />
  </div>
</article>

<style>
  .legal {
    padding-top: calc(var(--alto-menu) + 3rem);
  }
  .texto {
    margin-top: 2rem;
    max-width: 46rem;
    color: var(--texto-2);
  }
  .texto :global(p),
  .texto :global(ul),
  .texto :global(ol) {
    margin: 0 0 1rem;
  }
  .texto :global(a) {
    color: var(--cian);
  }
</style>
