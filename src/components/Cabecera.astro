---
/**
 * Menú fijo con anclas a cada sección y «Comprar entradas» siempre visible (también en el celular).
 * En el celular el menú es un `<details>`: funciona sin JavaScript; con JavaScript se cierra al
 * elegir una sección o con Escape.
 */
import Icono from './Icono.astro';
import Marca from './Marca.astro';
import type { Bloques } from '../lib/content';

interface Props {
  b: Bloques;
}
const { b } = Astro.props;
const enlaces = [
  { href: '/#evento', texto: b.t('global.menu.evento') },
  { href: '/#dia', texto: b.t('global.menu.dia') },
  { href: '/#noche', texto: b.t('global.menu.noche') },
  { href: '/#atracciones', texto: b.t('global.menu.atracciones') },
  { href: '/#concursos', texto: b.t('global.menu.concursos') },
  { href: '/#stands', texto: b.t('global.menu.stands') },
  { href: '/#sponsors', texto: b.t('global.menu.sponsors') },
  { href: '/#preguntas', texto: b.t('global.menu.preguntas') },
].filter((e) => e.texto);
const entradas = b.t('global.menu.entradas');
---

<header class="cabecera">
  <div class="contenedor fila">
    <a class="marca" href="/" aria-label={b.t('global.marca.nombre') ?? undefined}>
      <Marca b={b} />
    </a>
    <nav class="nav-escritorio" aria-label="Secciones">
      <ul>
        {enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
      </ul>
    </nav>
    {entradas && <a class="boton boton--chico noche entradas" href="/#entradas">{entradas}</a>}
    <details class="nav-movil">
      <summary aria-label="Abrir menú">
        <Icono nombre="menu" class="abrir" />
        <Icono nombre="cerrar" class="cerrar" />
      </summary>
      <nav aria-label="Secciones">
        <ul>
          {enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.nav-movil');
  if (menu) {
    const resumen = menu.querySelector('summary')!;
    const actualizar = () => resumen.setAttribute('aria-label', menu.open ? 'Cerrar menú' : 'Abrir menú');
    menu.addEventListener('toggle', actualizar);
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        resumen.focus();
      }
    });
  }
</script>

<style>
  .cabecera {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--alto-menu);
    background: rgb(8 7 12 / 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }
  .fila {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .marca {
    text-decoration: none;
    margin-right: auto;
  }
  .nav-escritorio {
    display: none;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-escritorio ul {
    display: flex;
    gap: 1.4rem;
  }
  nav a {
    font-family: var(--f-rotulo);
    font-size: 1.15rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--texto-2);
  }
  nav a:hover {
    color: var(--texto);
  }
  .entradas {
    flex: none;
  }
  .nav-movil summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--linea);
    cursor: pointer;
  }
  .nav-movil summary::-webkit-details-marker {
    display: none;
  }
  .nav-movil :global(.cerrar),
  .nav-movil[open] :global(.abrir) {
    display: none;
  }
  .nav-movil[open] :global(.cerrar) {
    display: block;
  }
  .nav-movil nav {
    position: absolute;
    inset: var(--alto-menu) 0 auto;
    background: var(--fondo);
    border-bottom: 1px solid var(--linea);
    padding: 0.5rem var(--margen) 1.5rem;
    max-height: calc(100svh - var(--alto-menu));
    overflow-y: auto;
  }
  .nav-movil li a {
    display: block;
    padding: 0.85rem 0;
    font-size: 1.6rem;
    border-bottom: 1px solid var(--linea);
  }
  @media (min-width: 1100px) {
    .nav-escritorio {
      display: block;
    }
    .nav-movil {
      display: none;
    }
    .marca {
      margin-right: 0;
    }
    .nav-escritorio {
      margin-inline: auto;
    }
  }
</style>
