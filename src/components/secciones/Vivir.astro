---
/** §3 Lo que vas a vivir: cuatro columnas (pilares), botón y banda de cifras. */
import type { Bloques, Colecciones } from '../../lib/content';

interface Props {
  b: Bloques;
  pilares: Colecciones['pilares'][];
  cifras: Colecciones['cifras'][];
}
const { b, pilares, cifras } = Astro.props;
const enlace = b.t('global.entradas.enlace');
---

{
  (pilares.length > 0 || cifras.length > 0) && (
    <section class="seccion vivir grano" aria-labelledby="titulo-vivir">
      <div class="contenedor">
        <h2 class="h2" id="titulo-vivir">{b.t('inicio.vivir.titulo')}</h2>
        {pilares.length > 0 && (
          <ol class="pilares" role="list">
            {pilares.map((p, i) => (
              <li>
                <span class="indice" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </li>
            ))}
          </ol>
        )}
        {enlace && b.t('inicio.vivir.boton') && (
          <a class="boton noche" href={enlace}>{b.t('inicio.vivir.boton')}</a>
        )}
      </div>
      {cifras.length > 0 && (
        <div class="banda">
          <ul class="contenedor cifras" role="list">
            {cifras.map((c) => (
              <li>
                <span class="numero">{c.numero}</span>
                <span class="texto">{c.texto}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )
}

<style>
  .vivir {
    isolation: isolate;
    background: radial-gradient(50rem 30rem at 0% 100%, rgb(255 107 18 / 0.14), transparent 65%);
  }
  .pilares {
    list-style: none;
    margin: clamp(2rem, 5vw, 3.5rem) 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  .pilares li {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea);
  }
  .indice {
    font-family: var(--f-rotulo);
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    color: var(--naranja);
  }
  h3 {
    font-family: var(--f-rotulo);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.02;
    letter-spacing: 0.02em;
  }
  .pilares p {
    color: var(--texto-2);
  }
  .banda {
    margin-top: var(--seccion);
    border-block: 1px solid var(--linea);
    background: linear-gradient(90deg, rgb(255 107 18 / 0.08), transparent 50%, rgb(255 107 18 / 0.08));
  }
  .cifras {
    list-style: none;
    margin-block: 0;
    display: grid;
    gap: 1.25rem;
    padding-block: 2.5rem;
  }
  .cifras li {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }
  .numero {
    font-family: var(--f-display);
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    line-height: 1;
  }
  .cifras li:first-child .numero {
    color: var(--dorado);
  }
  .texto {
    color: var(--texto-2);
    font-size: 0.98rem;
    line-height: 1.35;
  }
  @media (min-width: 700px) {
    .pilares {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .pilares {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .cifras {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }
    .numero {
      font-size: clamp(1.8rem, 2.5vw, 2.6rem);
    }
  }
</style>
