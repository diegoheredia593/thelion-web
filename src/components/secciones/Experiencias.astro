---
/** §2 Dos experiencias en un solo día: tarjeta De día (cian) y De noche (magenta). */
import Icono from '../Icono.astro';
import type { Bloques } from '../../lib/content';

interface Props {
  b: Bloques;
}
const { b } = Astro.props;
const tarjetas = [
  {
    clase: 'dia',
    icono: 'sol',
    ancla: '#dia',
    etiqueta: b.t('inicio.experiencias.diaEtiqueta'),
    titulo: b.t('inicio.experiencias.diaTitulo'),
    texto: b.t('inicio.experiencias.diaTexto'),
    boton: b.t('inicio.experiencias.diaBoton'),
  },
  {
    clase: 'noche',
    icono: 'luna',
    ancla: '#noche',
    etiqueta: b.t('inicio.experiencias.nocheEtiqueta'),
    titulo: b.t('inicio.experiencias.nocheTitulo'),
    texto: b.t('inicio.experiencias.nocheTexto'),
    boton: b.t('inicio.experiencias.nocheBoton'),
  },
].filter((t) => t.titulo);
---

<section class="seccion" id="evento" aria-labelledby="titulo-experiencias">
  <div class="contenedor">
    <h2 class="h2" id="titulo-experiencias">{b.t('inicio.experiencias.titulo')}</h2>
    <div class="tarjetas">
      {
        tarjetas.map((t) => (
          <article class:list={['tarjeta', t.clase]}>
            <Icono nombre={t.icono} tamano={40} class="icono" />
            {t.etiqueta && <p class="rotulo etiqueta">{t.etiqueta}</p>}
            <h3>{t.titulo}</h3>
            {t.texto && <p class="cuerpo">{t.texto}</p>}
            {t.boton && (
              <a class="boton boton--contorno" href={t.ancla}>
                {t.boton}
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .h2 {
    max-width: 18ch;
  }
  .tarjetas {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  .tarjeta {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: 1px solid color-mix(in srgb, var(--acento) 55%, transparent);
    border-radius: var(--radio);
    background:
      radial-gradient(28rem 16rem at 100% 0%, color-mix(in srgb, var(--acento) 16%, transparent), transparent 70%),
      var(--superficie);
    overflow: hidden;
  }
  .icono {
    color: var(--acento);
    filter: drop-shadow(var(--brillo));
  }
  .etiqueta {
    color: var(--acento);
  }
  h3 {
    font-family: var(--f-rotulo);
    font-weight: 400;
    font-size: clamp(2.2rem, 6vw, 3rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
  }
  .cuerpo {
    color: var(--texto-2);
    max-width: 34rem;
  }
  .boton {
    justify-self: start;
    margin-top: 0.5rem;
  }
  @media (min-width: 768px) {
    .tarjetas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
</style>
