---
/** §7 Concursos: $3.000 en premios. Tarjetas por concurso, pasos para participar y botones. */
import Icono from '../Icono.astro';
import { alFormulario } from '../../lib/enlaces';
import { real } from '../../lib/pendiente';
import type { Bloques, Colecciones } from '../../lib/content';

interface Props {
  b: Bloques;
  concursos: Colecciones['concursos'][];
  pasos: Colecciones['pasos'][];
  /** La página de bases tiene texto (si no, el botón no aparece). */
  hayBases: boolean;
}
const { b, concursos, pasos, hayBases } = Astro.props;
const rotulos = {
  cuando: b.t('inicio.concursos.cuando'),
  premios: b.t('inicio.concursos.premios'),
  como: b.t('inicio.concursos.comoParticipar'),
};
---

<section class="seccion concursos grano" id="concursos" data-whatsapp="concursante" aria-labelledby="titulo-concursos">
  <div class="contenedor">
    <div class="cabeza">
      <h2 class="h2" id="titulo-concursos">{b.t('inicio.concursos.titulo')}</h2>
      {b.t('inicio.concursos.texto') && <p class="lead">{b.t('inicio.concursos.texto')}</p>}
    </div>

    {
      concursos.length > 0 && (
        <ul class="tarjetas" role="list">
          {concursos.map((c) => {
            const reparto = real(c.reparto);
            const como = real(c.comoParticipar);
            return (
              <li class:list={['tarjeta', c.experiencia]}>
                <Icono nombre="trofeo" tamano={30} class="trofeo" />
                <h3>{c.nombre}</h3>
                {real(c.publico) && <p class="publico">{c.publico}</p>}
                <dl>
                  <div>
                    <dt class="rotulo">{rotulos.cuando}</dt>
                    <dd>{c.cuando}</dd>
                  </div>
                  <div>
                    <dt class="rotulo">{rotulos.premios}</dt>
                    <dd class="premio">{reparto ? `${c.premios}: ${reparto}` : c.premios}</dd>
                  </div>
                  {como && (
                    <div>
                      <dt class="rotulo">{rotulos.como}</dt>
                      <dd>{como}</dd>
                    </div>
                  )}
                </dl>
              </li>
            );
          })}
        </ul>
      )
    }

    {
      pasos.length > 0 && (
        <div class="pasos">
          {b.t('inicio.concursos.pasosTitulo') && <h3 class="rotulo subtitulo">{b.t('inicio.concursos.pasosTitulo')}</h3>}
          <ol role="list">
            {pasos.map((p, i) => (
              <li>
                <span class="n" aria-hidden="true">{i + 1}</span>
                <p>
                  <strong>{p.titulo}</strong>
                  {real(p.detalle) && <span> {p.detalle}</span>}
                </p>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    <div class="botones">
      {b.t('inicio.concursos.botonInscribir') && <a class="boton premio-boton" href={alFormulario('concursante')}>{b.t('inicio.concursos.botonInscribir')}</a>}
      {hayBases && b.t('inicio.concursos.botonBases') && <a class="boton boton--contorno premio-boton" href="/bases-concursos">{b.t('inicio.concursos.botonBases')}</a>}
    </div>
  </div>
</section>

<style>
  .concursos {
    isolation: isolate;
    background: radial-gradient(46rem 28rem at 100% 0%, rgb(255 107 18 / 0.16), transparent 65%);
  }
  .cabeza {
    display: grid;
    gap: 1rem;
  }
  .h2 {
    color: var(--dorado);
    text-shadow: 0 0 1.4rem rgb(255 179 38 / 0.35);
  }
  .tarjetas {
    list-style: none;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .tarjeta {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.5rem;
    border: 1px solid var(--linea);
    border-top: 3px solid var(--acento);
    border-radius: var(--radio);
    background: var(--superficie);
  }
  .tarjeta :global(.trofeo) {
    color: var(--dorado);
  }
  h3 {
    font-family: var(--f-rotulo);
    font-weight: 400;
    font-size: 1.8rem;
    line-height: 1;
    letter-spacing: 0.02em;
  }
  .publico {
    color: var(--acento);
    font-weight: 600;
    font-size: 0.95rem;
  }
  dl {
    margin: 0.4rem 0 0;
    display: grid;
    gap: 0.75rem;
  }
  dt {
    font-size: 0.95rem;
    color: var(--texto-3);
  }
  dd {
    margin: 0;
    color: var(--texto-2);
  }
  dd.premio {
    color: var(--dorado);
    font-weight: 700;
  }
  .pasos {
    margin-top: clamp(3rem, 7vw, 4rem);
  }
  .subtitulo {
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--dorado);
    margin-bottom: 1.25rem;
  }
  .pasos ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .pasos li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .n {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 2px solid var(--dorado);
    color: var(--dorado);
    font-family: var(--f-display);
    font-size: 1.3rem;
  }
  .pasos p {
    color: var(--texto-2);
    padding-top: 0.45rem;
  }
  .pasos strong {
    color: var(--texto);
  }
  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
  .premio-boton {
    --acento-boton: var(--dorado);
  }
  @media (min-width: 900px) {
    .tarjetas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .pasos ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }
</style>
