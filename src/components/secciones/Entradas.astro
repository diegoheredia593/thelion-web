---
/**
 * §8 Entradas: una tarjeta por localidad visible; cada botón va al `enlace` de su localidad en
 * Ticketshow. «Incluye» y la validez se muestran solo cuando tienen datos reales.
 */
import Icono from '../Icono.astro';
import { dolares } from '../../lib/formato';
import { real } from '../../lib/pendiente';
import type { Bloques, Colecciones } from '../../lib/content';

interface Props {
  b: Bloques;
  localidades: Colecciones['localidades'][];
}
const { b, localidades } = Astro.props;
const rotuloIncluye = b.t('inicio.entradas.incluye');
---

{
  localidades.length > 0 && (
    <section class="seccion" id="entradas" aria-labelledby="titulo-entradas">
      <div class="contenedor">
        <header class="cabeza">
          <h2 class="h2" id="titulo-entradas">{b.t('inicio.entradas.titulo')}</h2>
          {b.t('inicio.entradas.texto') && <p class="lead">{b.t('inicio.entradas.texto')}</p>}
        </header>

        <ul class="tarjetas" role="list">
          {localidades.map((l) => {
            const incluye = real(l.incluye);
            const validez = real(l.validez);
            return (
              <li class:list={['tarjeta', { destacada: l.destacada }]}>
                <h3 class="nombre">{l.nombre}</h3>
                <p class="precio">{dolares(l.precio)}</p>
                {validez && <p class="validez">{validez}</p>}
                {incluye && (
                  <div class="incluye">
                    {rotuloIncluye && <p class="rotulo">{rotuloIncluye}</p>}
                    <ul>
                      {incluye.map((i) => (
                        <li>{i}</li>
                      ))}
                    </ul>
                  </div>
                )}
                <a class="boton noche" href={l.enlace}>
                  {l.textoBoton}
                </a>
              </li>
            );
          })}
        </ul>

        {b.t('inicio.entradas.microcopy') && <p class="microcopy">{b.t('inicio.entradas.microcopy')}</p>}
        {b.t('inicio.entradas.aviso') && (
          <p class="aviso">
            <Icono nombre="escudo" tamano={22} />
            <span>{b.t('inicio.entradas.aviso')}</span>
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  .cabeza {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .tarjetas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: var(--superficie);
  }
  .tarjeta.destacada {
    border-color: var(--magenta);
    box-shadow: 0 0 2.5rem -1rem var(--magenta);
  }
  .nombre {
    font-family: var(--f-rotulo);
    font-weight: 400;
    font-size: 1.7rem;
    letter-spacing: 0.03em;
    line-height: 1;
  }
  .precio {
    font-family: var(--f-display);
    font-size: 3.4rem;
    line-height: 1;
    margin-block: 0.25rem 1.25rem;
  }
  .validez {
    color: var(--texto-2);
    font-size: 0.95rem;
  }
  .incluye ul {
    margin: 0.35rem 0 0;
    padding-left: 1.1rem;
    color: var(--texto-2);
    font-size: 0.95rem;
  }
  .incluye .rotulo {
    font-size: 0.95rem;
    color: var(--texto-3);
  }
  .boton {
    margin-top: auto;
    align-self: stretch;
    font-size: 1.1rem;
    letter-spacing: 0.03em;
    padding-inline: 0.75rem;
  }
  .microcopy {
    margin-top: 1.5rem;
    color: var(--texto-3);
    font-size: 0.95rem;
  }
  .aviso {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--linea);
    border-radius: 12px;
    color: var(--texto-2);
    font-size: 0.95rem;
  }
  .aviso :global(svg) {
    flex: none;
    color: var(--cian);
  }
  @media (min-width: 640px) {
    .tarjetas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .tarjetas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
