{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "thelion-web",
	"account_id": "84ffa5d2db10e557297317693d5ae3bf",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// El contenido y los formularios viven en la plataforma (Worker `agencia-plataforma`, cliente
	// `thelionhalloween`). Se la llama por service binding: Worker→Worker por workers.dev da error 1042.
	// La llave de la API es el secreto `PLATAFORMA_LLAVE` (npx wrangler secret put PLATAFORMA_LLAVE).
	"services": [{ "binding": "PLATAFORMA", "service": "agencia-plataforma" }],
	// Anti-spam de formularios (Cloudflare Turnstile). Vacío = desactivado.
	// La clave secreta va como secreto TURNSTILE_SECRET.
	"vars": {
		"TURNSTILE_SITE_KEY": ""
	},
	"observability": {
		"enabled": true
	}
}
